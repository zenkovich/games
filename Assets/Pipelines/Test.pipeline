        {
            "id": "529bf4f9-2a2e-4e41-bf76-5494ebc2523d",
            "type": "sourceText",
            "position": {
                "x": 400,
                "y": -8960
            },
            "size": {
                "width": 880,
                "height": 260
            },
            "config": {
                "text": "Дизайн персонажа: молодая антропоморфная мышка по имени Пип, главная героиня казуальной мобильной игры про поиск слов. Шустрая и любопытная. Фигура максимально приближенная к человеческой. Большие круглые уши с розовой внутренней частью, большие выразительные глаза, тёплый бежево-кремовый мех, маленький розовый нос, длинный тонкий хвост. Носит маленький жилет путешественника, цветной шарф, кожаную сумку. В остальной одежде имеет образ библиотекаря, университетского сотрудника. Держит лупу. Весёлое, озорное, решительное выражение. Полный рост, динамичная поза, одна лапка вперёд. Стиль: современная казуальная мобильная игра, вдохновение Royal Match, Toon Blast, Gardenscapes, 2D векторная иллюстрация, чистые толстые контуры, мягкие градиенты, яркие тёплые цвета, высокая читаемость, простые формы, милая и дружелюбная, центрированная композиция, мягкий градиентный фон. Мягкий студийный свет, без резких теней, игровой ассет, концепт-арт, вид спереди, на уровне глаз, высокое разрешение, 4k.",
                "sourceName": ""
            },
            "inputs": [],
            "outputs": [
                {
                    "id": "cd9a1ec3-aa57-49c5-8ee4-67cb55aa0519",
                    "name": "out",
                    "type": "text"
                }
            ]
        },
