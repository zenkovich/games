        {
            "id": "de79bb0c-5eec-45cb-83a5-03fe97946b2b",
            "type": "sourceText",
            "position": {
                "x": 9740,
                "y": -3040
            },
            "config": {
                "text": "Сделай звезду в той же стилистике, которая показана на референсах внутренние углы звезды должны быть максимально тупые. Так называемая пухлая звезда.Звезда должна вписываться в квадрат в котором на референсе помещается буква. Требуется чтобы звезда занимала как можно большую часть клетки. Внутри звезды нужно вписать букву. Цвет звезды и цвет буквы должны контрастировать так, чтобы буква легко читалась",
                "sourceName": ""
            },
            "inputs": [],
            "outputs": [
