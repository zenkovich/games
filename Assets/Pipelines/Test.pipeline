        },
        {
            "id": "8ee0b0d1-e140-4dd5-8f30-094a650391f0",
            "type": "sourceText",
            "position": {
                "x": 4280,
                "y": -9500
            },
            "config": {
                "text": "Два парсонажа сова и мышь из референсов стоят в комнате и смотрят в большую пустую книгу. Находятся в здании возможно библиотеки. Возможно университета. В большом окне в верхней части экрана открытое окно и в нем сидит сорока с зажатой в ключе буквой А. Персонажем смотрят на книгу с удивлением показывая на нее пальцем. ",
                "sourceName": ""
            },
            "inputs": [],
            "outputs": [
