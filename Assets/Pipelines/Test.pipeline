        {
            "id": "ade5888f-7a4c-4e36-b4ef-229a2e1d8905",
            "type": "sourceText",
            "position": {
                "x": 7420,
                "y": -5260
            },
            "config": {
                "text": "Стилизуй картинку под под приятные казуальные цвета. А буквы в зависимоти от расположеной на ней цифры светлее или темнее используя оттенок слоновой кости . Чем больше цифра тем темнее подложка под буквой. Сами буквы внутри квадратов имеют один цвет. Расположи слева от слова прогресс звезду, такую же какая есть в интерфейсе",
                "sourceName": ""
            },
            "inputs": [],
            "outputs": [
                {
                    "id": "f28e325b-258f-455e-a336-79c4472e019c",
                    "name": "out",
                    "type": "text"
                }
            ]
        },
        {
