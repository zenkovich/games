            },
            "size": {
                "width": 360,
                "height": 180
            },
            "config": {
                "text": "A mobile game concept based on the description. The gameplay must be generated strictly in accordance with the description. The image should not include a phone or anything else; the generated image alone must depict the gameplay, just like in a real mobile game.",
                "sourceName": ""
            },
            "inputs": [],
            "outputs": [
                {
