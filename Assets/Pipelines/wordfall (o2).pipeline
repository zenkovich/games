        },
        {
            "id": "d0e8ff53-cdea-4fa8-88f1-87baf855fcf8",
            "type": "sourceText",
            "position": {
                "x": -6260,
                "y": 1320
            },
            "size": {
                "width": 780,
                "height": 440
            },
            "config": {
                "text": "один основной игровой экран. Сверху уровень, ходы и прогресс-бар очков\nниже плашка с 4мя заданиями\nниже поле ввода слова из плашек букв, с кнопокй применить и крестик отменить\nниже поле с плашками букв, из которых игрок набирает слово\nниже панель с бустерами\n\nстиль казуальный. Без эффектов, только статика. Формат игры - вертикальный, 9:16 - строго укажи формат",
                "sourceName": ""
            },
