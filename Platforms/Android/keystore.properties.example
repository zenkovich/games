# Copy to `keystore.properties` and fill in — it is gitignored and must stay that way.
# Without this file the release build falls back to the shared debug key, which is
# fine locally and unusable for anything published.
#
# Create the keystore once and keep it safe (losing it means you can never ship an
# update to an already-installed app):
#
#   keytool -genkeypair -v -keystore ~/keys/zenkovich-games.jks \
#           -alias zenkovich -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=/Users/you/keys/zenkovich-games.jks
storePassword=
keyAlias=zenkovich
keyPassword=
